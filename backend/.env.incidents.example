PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/?appName=<app>
MONGO_DB=incidents
INCIDENTS_COLLECTION=incidents

# Poll every 15 minutes.
INCIDENTS_POLL_SECONDS=900
INCIDENTS_RESOLVE_TTL_MINUTES=180
INCIDENTS_AUTO_SOURCES_REGEX=waze|accidenteromania
INCIDENTS_TIMEOUT_SECONDS=20
INCIDENTS_MAX_ITEM_AGE_HOURS=72
INCIDENTS_USER_AGENT=BucharestIncidentBot/1.0
INCIDENTS_BUCHAREST_BBOX=44.25,25.80,44.62,26.35

# Comma-separated RSS/source URLs if you enable RSS ingestion.
TRUSTED_RSS_URLS=

# Optional city/location filter. Leave empty to use defaults.
BUCHAREST_KEYWORDS=

# Set true to test without writing to MongoDB.
INCIDENTS_DRY_RUN=false
